rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 320
        && data.displayName is string && data.displayName.size() <= 120
        && data.photoURL is string && data.photoURL.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTaskDoc(data, userId, taskId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'title', 'notes', 'priority',
          'energyRequired', 'durationMinutes', 'deadline',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'title', 'notes', 'priority',
          'energyRequired', 'durationMinutes', 'deadline',
          'status', 'createdAt', 'updatedAt', 'completedAt'
        ])
        && data.id is string && data.id == taskId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.notes is string && data.notes.size() <= 1000
        && data.priority in ['high', 'medium', 'low']
        && data.energyRequired in ['deep', 'medium', 'light']
        && data.durationMinutes is int && data.durationMinutes >= 15 && data.durationMinutes <= 480
        && data.deadline is string && data.deadline.size() >= 10 && data.deadline.size() <= 40
        && data.status in ['pending', 'scheduled', 'completed', 'missed']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('completedAt' in data) || (data.completedAt is string && data.completedAt.size() <= 40));
    }

    function isValidHabitDoc(data, userId, habitId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'title', 'category', 'targetLabel',
          'color', 'completedDates', 'archived', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'title', 'category', 'targetLabel',
          'color', 'completedDates', 'archived', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == habitId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 80
        && data.category in ['Coding', 'Fitness', 'Study', 'Wellness', 'Other']
        && data.targetLabel is string && data.targetLabel.size() <= 60
        && data.color is string && data.color.size() >= 4 && data.color.size() <= 16
        && data.completedDates is list && data.completedDates.size() <= 365
        && (data.completedDates.size() == 0 || (data.completedDates[0] is string && data.completedDates[0].size() <= 20))
        && data.archived is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPlannerSettings(settings) {
      return settings is map
        && settings.keys().hasAll([
          'bufferMinutes', 'autoRearrangeOnMiss', 'dailyGoalTasks',
          'theme', 'themePreset', 'accentColor'
        ])
        && settings.keys().hasOnly([
          'bufferMinutes', 'autoRearrangeOnMiss', 'dailyGoalTasks',
          'theme', 'themePreset', 'accentColor'
        ])
        && settings.bufferMinutes is int && settings.bufferMinutes >= 0 && settings.bufferMinutes <= 60
        && settings.autoRearrangeOnMiss is bool
        && settings.dailyGoalTasks is int && settings.dailyGoalTasks >= 1 && settings.dailyGoalTasks <= 10
        && settings.theme in ['light', 'dark']
        && settings.themePreset is string && settings.themePreset.size() <= 40
        && settings.accentColor is string && settings.accentColor.size() <= 16;
    }

    function isValidPlannerStateDoc(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'mood', 'todayOverrideDate', 'todayOverrideWindows',
          'weeklyFreeHours', 'blocks', 'dailyHistory', 'settings', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'mood', 'todayOverrideDate', 'todayOverrideWindows',
          'weeklyFreeHours', 'blocks', 'dailyHistory', 'settings', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == userId
        && data.mood in ['focused', 'energized', 'tired', 'stressed', 'overwhelmed']
        && data.todayOverrideDate is string && data.todayOverrideDate.size() <= 20
        && data.todayOverrideWindows is list && data.todayOverrideWindows.size() <= 12
        && (data.todayOverrideWindows.size() == 0 || data.todayOverrideWindows[0] is map)
        && data.weeklyFreeHours is map && data.weeklyFreeHours.size() <= 7
        && data.blocks is list && data.blocks.size() <= 200
        && (data.blocks.size() == 0 || data.blocks[0] is map)
        && data.dailyHistory is map && data.dailyHistory.size() <= 400
        && isValidPlannerSettings(data.settings)
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'photoURL', 'updatedAt']);
      allow delete: if false;

      match /tasks/{taskId} {
        allow get: if isOwner(userId) && isValidId(taskId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(taskId)
          && isValidTaskDoc(incoming(), userId, taskId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId)
          && isValidId(taskId)
          && isValidTaskDoc(incoming(), userId, taskId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'completedAt', 'updatedAt'])) ||
            (incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'notes', 'priority', 'energyRequired',
              'durationMinutes', 'deadline', 'status', 'completedAt', 'updatedAt'
            ]))
          );
        allow delete: if isOwner(userId) && isValidId(taskId);
      }

      match /habits/{habitId} {
        allow get: if isOwner(userId) && isValidId(habitId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(habitId)
          && isValidHabitDoc(incoming(), userId, habitId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId)
          && isValidId(habitId)
          && isValidHabitDoc(incoming(), userId, habitId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (incoming().diff(existing()).affectedKeys().hasOnly(['completedDates', 'updatedAt'])) ||
            (incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'category', 'targetLabel', 'color', 'archived', 'updatedAt'
            ])) ||
            (incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'category', 'targetLabel', 'color', 'completedDates', 'archived', 'updatedAt'
            ]))
          );
        allow delete: if isOwner(userId) && isValidId(habitId);
      }

      match /planner/{plannerId} {
        allow get: if isOwner(userId) && isValidId(plannerId) && plannerId == 'state';
        allow create: if isOwner(userId)
          && isValidId(plannerId)
          && plannerId == 'state'
          && isValidPlannerStateDoc(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId)
          && isValidId(plannerId)
          && plannerId == 'state'
          && isValidPlannerStateDoc(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'mood', 'todayOverrideDate', 'todayOverrideWindows',
              'weeklyFreeHours', 'blocks', 'dailyHistory', 'settings', 'updatedAt'
            ])
          );
        allow delete: if false;
      }
    }
  }
}
